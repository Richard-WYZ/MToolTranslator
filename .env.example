# Copy this file to .env and fill in your provider details.
# .env is ignored by git and should not be committed.

MODEL_PROVIDER=api
THIRD_PARTY_API_STYLE=opencode_go
# Quality-oriented default. For speed benchmarking, try api:minimax-m3 and
# expect to repair/review long dialogue output afterward.
DEFAULT_MODEL=api:qwen3.7-plus
THIRD_PARTY_API_BASE_URL=https://opencode.ai/zen/go/v1
THIRD_PARTY_API_KEY=
THIRD_PARTY_API_MODELS=glm-5.2,glm-5.1,kimi-k2.7-code,kimi-k2.6,deepseek-v4-pro,deepseek-v4-flash,mimo-v2.5,mimo-v2.5-pro,minimax-m3,minimax-m2.7,minimax-m2.5,qwen3.7-max,qwen3.7-plus,qwen3.6-plus
THIRD_PARTY_API_DISABLED_MODELS=
THIRD_PARTY_API_DISABLE_THINKING=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_DISABLED_MODELS=

# Enable after small-sample validation. Start conservatively, then profile 8-12.
BATCH_API_PARALLEL_ENABLED=true
BATCH_API_CONCURRENCY=5
BATCH_API_MAX_RETRIES=2
BATCH_PROTOCOL=line
BATCH_JSON_BATCH_SIZE=40
BATCH_MAX_BATCH_CHARS=8000
BATCH_NUM_PREDICT=3072
BATCH_QUALITY_NUM_PREDICT=4096
BATCH_TIMEOUT=180

# Optional hybrid routing: fast model only for short labels; quality model for
# dialogue/narration and non-short batches. Long batches are forced away from
# line protocol to avoid alignment drift.
BATCH_API_MODEL_ROUTING_ENABLED=true
BATCH_API_FAST_MODEL=api:minimax-m3
BATCH_API_QUALITY_MODEL=api:qwen3.7-plus
BATCH_LINE_FOR_SHORT_ONLY=true
BATCH_SHORT_LINE_MAX_CHARS=80
